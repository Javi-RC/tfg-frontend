{
  "rewrites": [
    { "source": "/auth/callback", "destination": "/index.html" },
    { "source": "/auth/confirm", "destination": "/index.html" },
    { "source": "/auth/:path*", "destination": "https://tfg-backend-six.vercel.app/auth/:path*" },
    { "source": "/api/:path*", "destination": "https://tfg-backend-six.vercel.app/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
