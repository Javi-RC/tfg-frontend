import React, { useState, useEffect } from 'react';
import { 
  getTeamAnalysis, 
  suggestTeam,
  predictProjectRisks, 
  assignEmployeeToProject, 
  removeEmployeeFromProject 
} from '../../api/projects';
import { getOrganizationEmployees } from '../../api/organization';
import PrimaryButton from '../PrimaryButton';
import SecondaryButton from '../SecondaryButton';
import { RISK_SEVERITY_COLORS } from '../../types/projectTypes';

/**
 * Draft Team Analysis Component
 * Shows optimal team + risk analysis for Draft projects
 * Allows dynamic team modification with live risk recalculation
 * IMPROVED UX: Multi-select employees and shows ALL organization employees
 */
export default function DraftTeamAnalysis({ project, onProjectUpdate }) {
  const [teamAnalysis, setTeamAnalysis] = useState(null);
  const [allEmployees, setAllEmployees] = useState([]);
  const [riskAnalysis, setRiskAnalysis] = useState(null);
  const [loading, setLoading] = useState(true);
  const [riskLoading, setRiskLoading] = useState(false);
  const [assignLoading, setAssignLoading] = useState(false);
  const [error, setError] = useState(null);
  const [expandedRisks, setExpandedRisks] = useState({});
  const [selectedEmployees, setSelectedEmployees] = useState([]);
  const [searchQuery, setSearchQuery] = useState('');

  useEffect(() => {
    loadAnalysis();
  }, [project._id]);

  useEffect(() => {
    // Recalculate risks whenever project.assignedEmployees changes
    if (project.assignedEmployees?.length > 0) {
      loadRiskAnalysis();
    } else {
      setRiskAnalysis(null);
    }
  }, [project.assignedEmployees]);

  // Auto-expand high/critical risks on load
  useEffect(() => {
    if (riskAnalysis?.risks) {
      const highPriorityRisks = {};
      riskAnalysis.risks.forEach((risk, index) => {
        if (['high', 'critical'].includes(risk.severity)) {
          highPriorityRisks[`${risk.type}-${index}`] = true;
        }
      });
      setExpandedRisks(highPriorityRisks);
    }
  }, [riskAnalysis]);

  const loadAnalysis = async () => {
    try {
      setLoading(true);
      setError(null);

      // Load team analysis (recommendations with scores)
      const teamResponse = await getTeamAnalysis(project._id);
      const teamData = teamResponse.data?.data || teamResponse.data;
      setTeamAnalysis(teamData);

      console.log('🔍 Team Analysis Response:', teamData);

      // Load ALL employees from the organization
      const employeesResponse = await getOrganizationEmployees(project.organization._id || project.organization);
      const employeesData = employeesResponse.data?.data || employeesResponse.data;
      
      // Handle different response structures
      let employeesList = employeesData.employees || employeesData || [];
      
      console.log('👥 All Employees Count:', employeesList.length);
      console.log('✅ Assigned Employees:', project.assignedEmployees);

      // Get IDs of already assigned employees
      const assignedIds = new Set(
        project.assignedEmployees?.map(emp => 
          typeof emp === 'string' ? emp : (emp._id || emp.user?._id)
        ) || []
      );
      
      console.log('🚫 Assigned IDs:', Array.from(assignedIds));
      
      // Filter out already assigned employees from the list
      employeesList = employeesList.filter(emp => 
        !assignedIds.has(emp.user._id)
      );
      
      console.log('📋 Available Employees Count:', employeesList.length);
      
      // If no employees found, just use suggested team
      if (employeesList.length === 0) {
        setAllEmployees([]);
      } else {
        // Get suggestions from team analysis
        // Backend returns 'suggestions' (not 'suggestedTeam') - these are complementary employees
        const suggestions = teamData.suggestions || teamData.suggestedTeam || [];
        
        console.log('💡 Suggestions from backend:', suggestions.length, 'employees');
        console.log('💡 First 3 suggestions:', suggestions.slice(0, 3).map(s => ({ userId: s.userId, name: s.user?.name, score: s.score })));
        
        // Merge employees with their recommendation scores if available
        const employeesWithScores = employeesList.map(emp => {
          const recommendation = suggestions.find(s => s.userId === emp.user._id);
          return {
            ...emp,
            matchPercentage: recommendation?.matchPercentage || 0,
            score: recommendation?.score || 999, // High score = lower priority
            matchedSkills: recommendation?.matchedSkills || [],
            missingSkills: recommendation?.missingSkills || [],
            isRecommended: !!recommendation
          };
        });

        console.log('📊 Result:', employeesWithScores.filter(e => e.isRecommended).length, 'recommended out of', employeesWithScores.length);

        // Sort by score (lower is better) and match percentage
        employeesWithScores.sort((a, b) => {
          if (a.isRecommended && !b.isRecommended) return -1;
          if (!a.isRecommended && b.isRecommended) return 1;
          if (a.score !== b.score) return a.score - b.score;
          return b.matchPercentage - a.matchPercentage;
        });

        setAllEmployees(employeesWithScores);
      }

      // Load initial risks
      if (project.assignedEmployees.length === 0) {
        await loadRiskAnalysis();
      }

    } catch (err) {
      console.error('Error loading analysis:', err);
      setError(err.response?.data?.error || 'Error loading team analysis');
    } finally {
      setLoading(false);
    }
  };

  const handleAssignSelected = async () => {
    if (selectedEmployees.length === 0) {
      alert('Please select at least one employee');
      return;
    }

    try {
      setAssignLoading(true);
      
      // Assign all selected employees
      const assignPromises = selectedEmployees.map(empId => 
        assignEmployeeToProject(project._id, {
          employeeId: empId,
          assignedRole: 'Developer'
        })
      );

      await Promise.all(assignPromises);
      
      // Clear selection
      setSelectedEmployees([]);
      
      // Notify parent to refresh project
      if (onProjectUpdate) {
        await onProjectUpdate();
      }

      alert(`${selectedEmployees.length} employee(s) assigned successfully`);
    } catch (err) {
      alert(err.response?.data?.error || 'Error assigning employees');
    } finally {
      setAssignLoading(false);
    }
  };

  const toggleEmployeeSelection = (employeeId) => {
    setSelectedEmployees(prev => 
      prev.includes(employeeId)
        ? prev.filter(id => id !== employeeId)
        : [...prev, employeeId]
    );
  };

  const selectAllVisible = () => {
    const visibleEmployeeIds = getFilteredAvailableEmployees()
      .map(emp => emp.user._id);
    setSelectedEmployees(visibleEmployeeIds);
  };

  const clearSelection = () => {
    setSelectedEmployees([]);
  };

  const loadRiskAnalysis = async () => {
    try {
      setRiskLoading(true);
      
      const riskResponse = await predictProjectRisks(project._id);
      const riskData = riskResponse.data?.data || riskResponse.data;
      setRiskAnalysis(riskData);

    } catch (err) {
      console.error('Error loading risk analysis:', err);
    } finally {
      setRiskLoading(false);
    }
  };

  const getFilteredAvailableEmployees = () => {
    const assignedIds = project.assignedEmployees?.map(emp => emp.employee) || [];
    const available = allEmployees.filter(emp => !assignedIds.includes(emp.user._id));
    
    if (!searchQuery.trim()) return available;
    
    const query = searchQuery.toLowerCase();
    return available.filter(emp => 
      emp.user.name.toLowerCase().includes(query) ||
      emp.user.email.toLowerCase().includes(query) ||
      emp.matchedSkills.some(skill => skill.toLowerCase().includes(query))
    );
  };

  const handleRemoveEmployee = async (employeeId) => {
    if (!window.confirm('Remove this employee from the project?')) {
      return;
    }

    try {
      await removeEmployeeFromProject(project._id, employeeId);
      
      if (onProjectUpdate) {
        await onProjectUpdate();
      }

      alert('Employee removed successfully');
    } catch (err) {
      alert(err.response?.data?.error || 'Error removing employee');
    }
  };

  const toggleRiskExpanded = (riskId) => {
    setExpandedRisks(prev => ({
      ...prev,
      [riskId]: !prev[riskId]
    }));
  };

  const getRiskTitle = (risk) => {
    if (risk.title) return risk.title;
    
    // Generate friendly title from type if title is missing
    const typeToTitle = {
      'skill_gap': 'Technology Skills Gap',
      'communication_breakdown': 'Communication Barriers',
      'team_overload': 'Team Overload',
      'process_mismatch': 'Process Mismatch',
      'role_clarity_gap': 'Role Clarity Issues',
      'scope_creep': 'Scope Creep Risk',
      'technical_infrastructure': 'Technical Infrastructure Issues',
      'timezone_scheduling_gap': 'Timezone & Scheduling Conflicts',
      'knowledge_management_gap': 'Knowledge Management Gap',
      'resource_unavailability': 'Resource Unavailability',
      'integration_complexity': 'Integration Complexity',
      'dependency_risk': 'External Dependencies Risk',
    };
    
    return typeToTitle[risk.type] || risk.type.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
  };

  const getRiskDescription = (risk) => {
    if (risk.description) return risk.description;
    
    // Fallback: use reasoning if available
    if (risk.reasoning && risk.reasoning.length > 0) {
      return risk.reasoning.join('. ');
    }
    
    return 'No description available';
  };

  const getRiskSeverityColor = (severity) => {
    return RISK_SEVERITY_COLORS[severity] || '#6c757d';
  };

  const calculateOverallRiskLevel = () => {
    if (!riskAnalysis?.risks) return 'Low';
    
    const risks = riskAnalysis.risks;
    const criticalCount = risks.filter(r => r.severity === 'critical').length;
    const highCount = risks.filter(r => r.severity === 'high').length;
    
    if (criticalCount > 0) return 'Critical';
    if (highCount > 2) return 'High';
    if (highCount > 0) return 'Medium';
    return 'Low';
  };

  const getOverallRiskColor = () => {
    const level = calculateOverallRiskLevel();
    const colors = {
      'Critical': '#dc3545',
      'High': '#fd7e14',
      'Medium': '#ffc107',
      'Low': '#28a745'
    };
    return colors[level] || '#6c757d';
  };

  if (loading) {
    return (
      <div style={styles.loadingContainer}>
        <div style={styles.spinner}></div>
        <p>Loading team analysis...</p>
      </div>
    );
  }

  if (error) {
    return (
      <div style={styles.errorContainer}>
        <span style={styles.errorIcon}>⚠️</span>
        <p>{error}</p>
        <SecondaryButton onClick={loadAnalysis}>Retry</SecondaryButton>
      </div>
    );
  }

  const hasAssignedTeam = project.assignedEmployees?.length > 0;
  const currentTeam = teamAnalysis?.currentTeam || [];
  const availableEmployees = getFilteredAvailableEmployees();
  const recommendedEmployees = availableEmployees.filter(emp => emp.isRecommended);
  const otherEmployees = availableEmployees.filter(emp => !emp.isRecommended);

  return (
    <div style={styles.container}>
      <div style={styles.header}>
        <h3 style={styles.title}>
          {hasAssignedTeam ? '👥 Team Management' : '💡 Team Builder'}
        </h3>
        <div style={styles.headerInfo}>
          {hasAssignedTeam && (
            <span style={styles.teamSize}>
              {project.assignedEmployees.length} assigned
            </span>
          )}
          {selectedEmployees.length > 0 && (
            <span style={styles.selectedCount}>
              {selectedEmployees.length} selected
            </span>
          )}
        </div>
      </div>

      <div style={styles.splitView}>
        {/* LEFT PANEL - Team Management */}
        <div style={styles.leftPanel}>
          {/* Current Assigned Team */}
          {hasAssignedTeam && (
            <div style={styles.assignedSection}>
              <div style={styles.sectionHeader}>
                <h4 style={styles.sectionTitle}>Assigned Team</h4>
              </div>
              {currentTeam.length > 0 ? (
                <div style={styles.employeeList}>
                  {currentTeam.map((member) => (
                    <div key={member.userId} style={styles.assignedEmployeeCard}>
                      <div style={styles.employeeInfo}>
                        <div style={styles.employeeName}>{member.user.name}</div>
                        <div style={styles.employeeEmail}>{member.user.email}</div>
                        <div style={styles.employeeRole}>{member.assignedRole}</div>
                      </div>
                      <div style={styles.employeeMetrics}>
                        {member.matchPercentage > 0 && (
                          <div style={styles.matchBadge}>
                            {member.matchPercentage}%
                          </div>
                        )}
                      </div>
                      <SecondaryButton 
                        onClick={() => handleRemoveEmployee(member.userId)}
                        style={{ fontSize: '12px', padding: '4px 8px' }}
                      >
                        Remove
                      </SecondaryButton>
                    </div>
                  ))}
                </div>
              ) : (
                <div style={styles.emptyState}>
                  <p>Loading assigned team...</p>
                </div>
              )}
            </div>
          )}

          {/* Available Employees Section */}
          <div style={hasAssignedTeam ? { marginTop: '20px' } : {}}>
            <div style={styles.sectionHeader}>
              <h4 style={styles.sectionTitle}>
                {hasAssignedTeam ? 'Available Employees' : 'All Employees'}
                <span style={styles.employeeCount}>
                  ({availableEmployees.length} available)
                </span>
              </h4>
              
              {/* Search Bar */}
              <input
                type="text"
                placeholder="Search by name, email or skill..."
                value={searchQuery}
                onChange={(e) => setSearchQuery(e.target.value)}
                style={styles.searchInput}
              />
            </div>

            {/* Multi-select Controls */}
            {availableEmployees.length > 0 && (
              <div style={styles.controlsBar}>
                <div style={styles.selectionControls}>
                  <button 
                    onClick={selectAllVisible} 
                    style={styles.selectAllButton}
                    disabled={availableEmployees.length === 0}
                  >
                    Select All ({availableEmployees.length})
                  </button>
                  {selectedEmployees.length > 0 && (
                    <button 
                      onClick={clearSelection} 
                      style={styles.clearButton}
                    >
                      Clear
                    </button>
                  )}
                </div>
                {selectedEmployees.length > 0 && (
                  <PrimaryButton 
                    onClick={handleAssignSelected}
                    disabled={assignLoading}
                    style={{ fontSize: '13px', padding: '8px 16px' }}
                  >
                    {assignLoading 
                      ? 'Assigning...' 
                      : `Assign Selected (${selectedEmployees.length})`
                    }
                  </PrimaryButton>
                )}
              </div>
            )}

            {/* Recommended Employees */}
            {recommendedEmployees.length > 0 && (
              <div>
                <div style={styles.categoryHeader}>
                  <span style={styles.categoryBadge}>⭐ Recommended</span>
                  <span style={styles.categoryCount}>{recommendedEmployees.length}</span>
                </div>
                <div style={styles.employeeList}>
                  {recommendedEmployees.map((emp) => {
                    const isSelected = selectedEmployees.includes(emp.user._id);
                    return (
                      <div
                        key={emp.user._id}
                        style={{
                          ...styles.employeeCard,
                          ...(isSelected ? styles.employeeCardSelected : {})
                        }}
                        onClick={() => toggleEmployeeSelection(emp.user._id)}
                      >
                        <input
                          type="checkbox"
                          checked={isSelected}
                          onChange={() => {}}
                          style={styles.checkbox}
                        />
                        <div style={styles.employeeContent}>
                          <div style={styles.employeeInfo}>
                            <div style={styles.employeeName}>{emp.user.name}</div>
                            <div style={styles.employeeEmail}>{emp.user.email}</div>
                          </div>
                          <div style={styles.employeeMetrics}>
                            <div style={styles.matchBadge}>
                              {emp.matchPercentage}%
                            </div>
                            <div style={styles.scoreBadge}>
                              Score: {emp.score.toFixed(1)}
                            </div>
                          </div>
                          {emp.matchedSkills.length > 0 && (
                            <div style={styles.skillsList}>
                              <strong style={styles.skillsLabel}>✅</strong>
                              {emp.matchedSkills.slice(0, 4).map(skill => (
                                <span key={skill} style={styles.skillChip}>{skill}</span>
                              ))}
                              {emp.matchedSkills.length > 4 && (
                                <span style={styles.skillMore}>
                                  +{emp.matchedSkills.length - 4}
                                </span>
                              )}
                            </div>
                          )}
                          {emp.missingSkills.length > 0 && (
                            <div style={styles.skillsList}>
                              <strong style={styles.skillsLabelWarning}>⚠️</strong>
                              {emp.missingSkills.slice(0, 2).map(skill => (
                                <span key={skill} style={styles.skillChipWarning}>{skill}</span>
                              ))}
                            </div>
                          )}
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>
            )}

            {/* Other Employees */}
            {otherEmployees.length > 0 && (
              <div style={{ marginTop: '15px' }}>
                <div style={styles.categoryHeader}>
                  <span style={styles.categoryBadge}>👤 Other Employees</span>
                  <span style={styles.categoryCount}>{otherEmployees.length}</span>
                </div>
                <div style={styles.employeeList}>
                  {otherEmployees.map((emp) => {
                    const isSelected = selectedEmployees.includes(emp.user._id);
                    return (
                      <div
                        key={emp.user._id}
                        style={{
                          ...styles.employeeCard,
                          ...(isSelected ? styles.employeeCardSelected : {})
                        }}
                        onClick={() => toggleEmployeeSelection(emp.user._id)}
                      >
                        <input
                          type="checkbox"
                          checked={isSelected}
                          onChange={() => {}}
                          style={styles.checkbox}
                        />
                        <div style={styles.employeeContent}>
                          <div style={styles.employeeInfo}>
                            <div style={styles.employeeName}>{emp.user.name}</div>
                            <div style={styles.employeeEmail}>{emp.user.email}</div>
                          </div>
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>
            )}

            {availableEmployees.length === 0 && (
              <div style={styles.emptyState}>
                <p>
                  {searchQuery 
                    ? 'No employees match your search' 
                    : 'All employees have been assigned'}
                </p>
              </div>
            )}
          </div>
        </div>

        {/* RIGHT PANEL - Risk Analysis */}
        <div style={styles.rightPanel}>
          <div style={styles.sectionHeader}>
            <h4 style={styles.sectionTitle}>⚠️ Risk Analysis</h4>
            {riskLoading && <div style={styles.miniSpinner}></div>}
          </div>

          {riskLoading ? (
            <div style={styles.loadingState}>
              <div style={styles.spinner}></div>
              <p>Analyzing risks...</p>
            </div>
          ) : !riskAnalysis ? (
            <div style={styles.emptyState}>
              <span style={styles.emptyIcon}>📊</span>
              <p>
                {hasAssignedTeam 
                  ? 'Assign employees to see risk analysis' 
                  : 'Risk analysis will appear here'}
              </p>
            </div>
          ) : (
            <div style={styles.riskContent}>
              {/* Overall Risk Level */}
              <div 
                style={{
                  ...styles.overallRiskBadge,
                  backgroundColor: getOverallRiskColor()
                }}
              >
                Overall Risk: {calculateOverallRiskLevel()}
              </div>

              {/* System Info Banner */}
              {riskAnalysis.metadata && (
                <div style={styles.systemBanner}>
                  <div style={styles.systemBannerContent}>
                    <span style={styles.systemBadge}>
                      {riskAnalysis.metadata.systemPhase === 'tree-dominant' && '🌳 Rule-Based'}
                      {riskAnalysis.metadata.systemPhase === 'balanced' && '⚖️ Hybrid'}
                      {riskAnalysis.metadata.systemPhase === 'cbr-dominant' && '🧠 Case-Based'}
                    </span>
                    <span style={styles.systemInfo}>
                      {riskAnalysis.metadata.caseBaseSize} historical cases • {(riskAnalysis.metadata.overallConfidence * 100).toFixed(0)}% confidence
                    </span>
                  </div>
                  {riskAnalysis.metadata.weights && (
                    <div style={styles.weightsInfo}>
                      DT: {(riskAnalysis.metadata.weights.decisionTree * 100).toFixed(0)}% | 
                      CBR: {(riskAnalysis.metadata.weights.cbr * 100).toFixed(0)}%
                    </div>
                  )}
                </div>
              )}

              {/* Team Insights */}
              {riskAnalysis.metadata?.teamInsights && (
                <div style={styles.insightsCard}>
                  <div style={styles.insightsHeader}>👥 Team Analysis</div>
                  <div style={styles.insightsGrid}>
                    <div style={styles.insightItem}>
                      <span style={styles.insightLabel}>Skills Coverage</span>
                      <span style={{
                        ...styles.insightValue,
                        color: (riskAnalysis.metadata.teamInsights.skillsCoverage || 0) >= 80 ? '#10b981' : 
                               (riskAnalysis.metadata.teamInsights.skillsCoverage || 0) >= 60 ? '#f59e0b' : '#ef4444'
                      }}>
                        {riskAnalysis.metadata.teamInsights.skillsCoverage != null ? `${riskAnalysis.metadata.teamInsights.skillsCoverage}%` : 'N/A'}
                      </span>
                    </div>
                    <div style={styles.insightItem}>
                      <span style={styles.insightLabel}>Experience</span>
                      <span style={styles.insightValue}>
                        {riskAnalysis.metadata.teamInsights.experienceLevel || 'N/A'}
                      </span>
                    </div>
                    <div style={styles.insightItem}>
                      <span style={styles.insightLabel}>Team Size</span>
                      <span style={styles.insightValue}>
                        {riskAnalysis.metadata.teamInsights.teamSizeAdequate != null 
                          ? (riskAnalysis.metadata.teamInsights.teamSizeAdequate ? '✓ Adequate' : '⚠ Inadequate')
                          : 'N/A'
                        }
                      </span>
                    </div>
                    <div style={styles.insightItem}>
                      <span style={styles.insightLabel}>Personality</span>
                      <span style={styles.insightValue}>
                        {riskAnalysis.metadata.teamInsights.personalityBalance || 'N/A'}
                      </span>
                    </div>
                  </div>
                </div>
              )}

              {/* Risk Metrics */}
              {riskAnalysis.metadata && (
                <div style={styles.metricsRow}>
                  <div style={styles.metricCard}>
                    <div style={styles.metricLabel}>High/Critical</div>
                    <div style={styles.metricValue}>
                      {riskAnalysis.risks.filter(r => ['high', 'critical'].includes(r.severity)).length}
                    </div>
                  </div>
                  <div style={styles.metricCard}>
                    <div style={styles.metricLabel}>Total Risks</div>
                    <div style={styles.metricValue}>
                      {riskAnalysis.risks.length}
                    </div>
                  </div>
                  <div style={styles.metricCard}>
                    <div style={styles.metricLabel}>Sources</div>
                    <div style={styles.metricValue}>
                      {riskAnalysis.metadata.sources?.decisionTree || 0} DT + {riskAnalysis.metadata.sources?.cbr || 0} CBR
                    </div>
                  </div>
                </div>
              )}

              {/* Risk List */}
              <div style={styles.risksList}>
                {riskAnalysis.risks.map((risk, index) => (
                  <div 
                    key={`${risk.type}-${index}`} 
                    style={styles.riskCard}
                  >
                    <div 
                      style={styles.riskHeader}
                      onClick={() => toggleRiskExpanded(`${risk.type}-${index}`)}
                    >
                      <div style={styles.riskTitleRow}>
                        <span 
                          style={{
                            ...styles.riskSeverityBadge,
                            backgroundColor: getRiskSeverityColor(risk.severity)
                          }}
                        >
                          {risk.severity.toUpperCase()}
                        </span>
                        <span style={styles.riskTitle}>{getRiskTitle(risk)}</span>
                      </div>
                      <span style={styles.expandIcon}>
                        {expandedRisks[`${risk.type}-${index}`] ? '▼' : '▶'}
                      </span>
                    </div>

                    {expandedRisks[`${risk.type}-${index}`] && (
                      <div style={styles.riskDetails}>
                        <p style={styles.riskDescription}>{getRiskDescription(risk)}</p>
                        
                        <div style={styles.riskMetrics}>
                          <div style={styles.riskMetricItem}>
                            <strong>Probability:</strong> {(risk.probability * 100).toFixed(0)}%
                          </div>
                          <div style={styles.riskMetricItem}>
                            <strong>Confidence:</strong> {(risk.confidence * 100).toFixed(0)}%
                          </div>
                          {risk.expectedWeek && (
                            <div style={styles.riskMetricItem}>
                              <strong>Expected Week:</strong> Week {risk.expectedWeek}
                              {risk.expectedWeekRange && ` (${risk.expectedWeekRange.min}-${risk.expectedWeekRange.max})`}
                            </div>
                          )}
                        </div>

                        {/* Predicted Impact */}
                        {risk.predictedImpact && (
                          <div style={styles.impactBox}>
                            <strong style={styles.impactTitle}>📊 Predicted Impact:</strong>
                            <div style={styles.impactGrid}>
                              {risk.predictedImpact.scheduleDelay && (
                                <div style={styles.impactItem}>
                                  <div style={styles.impactLabel}>⏱️ Schedule Delay</div>
                                  <div style={styles.impactRange}>
                                    {risk.predictedImpact.scheduleDelay.min}-{risk.predictedImpact.scheduleDelay.max}%
                                  </div>
                                  <div style={styles.impactDesc}>{risk.predictedImpact.scheduleDelay.description}</div>
                                </div>
                              )}
                              {risk.predictedImpact.budgetOverrun && (
                                <div style={styles.impactItem}>
                                  <div style={styles.impactLabel}>💰 Budget Overrun</div>
                                  <div style={styles.impactRange}>
                                    {risk.predictedImpact.budgetOverrun.min}-{risk.predictedImpact.budgetOverrun.max}%
                                  </div>
                                  <div style={styles.impactDesc}>{risk.predictedImpact.budgetOverrun.description}</div>
                                </div>
                              )}
                              {risk.predictedImpact.qualityImpact && (
                                <div style={styles.impactItem}>
                                  <div style={styles.impactLabel}>🎯 Quality Impact</div>
                                  <div style={styles.impactValue}>{risk.predictedImpact.qualityImpact}</div>
                                </div>
                              )}
                              {risk.predictedImpact.teamMoraleImpact && (
                                <div style={styles.impactItem}>
                                  <div style={styles.impactLabel}>👥 Morale Impact</div>
                                  <div style={styles.impactValue}>{risk.predictedImpact.teamMoraleImpact}</div>
                                </div>
                              )}
                            </div>
                          </div>
                        )}

                        {/* Early Warning Signals */}
                        {risk.earlyWarningSignals && risk.earlyWarningSignals.length > 0 && (
                          <div style={styles.warningSignalsBox}>
                            <strong style={styles.warningSignalsTitle}>🚨 Early Warning Signals:</strong>
                            <div style={styles.warningSignalsList}>
                              {risk.earlyWarningSignals.map((signal, i) => (
                                <div key={i} style={styles.warningSignalItem}>
                                  <div style={styles.warningSignalText}>{signal.signal}</div>
                                  <div style={styles.warningSignalMeta}>
                                    <span>Threshold: {signal.threshold}</span>
                                    <span>Check: {signal.checkFrequency}</span>
                                  </div>
                                </div>
                              ))}
                            </div>
                          </div>
                        )}

                        {/* Similar Cases */}
                        {risk.basedOnCases && risk.basedOnCases.length > 0 && (
                          <div style={styles.similarCasesBox}>
                            <strong style={styles.similarCasesTitle}>📚 Based on Similar Cases:</strong>
                            {risk.basedOnCases.map((case_, i) => (
                              <div key={i} style={styles.similarCaseItem}>
                                <span style={styles.similarityBadge}>{(case_.similarity * 100).toFixed(0)}% match</span>
                                <span style={styles.caseDescription}>{case_.description}</span>
                              </div>
                            ))}
                          </div>
                        )}

                        {risk.recommendations && risk.recommendations.length > 0 && (
                          <div style={styles.recommendationsBox}>
                            <strong style={styles.recommendationsTitle}>💡 Recommendations:</strong>
                            <ul style={styles.recommendationsList}>
                              {risk.recommendations.map((rec, i) => (
                                <li key={i}>{rec}</li>
                              ))}
                            </ul>
                          </div>
                        )}

                        {risk.reasoning && risk.reasoning.length > 0 && (
                          <div style={styles.reasoningBox}>
                            <strong>📋 Reasoning:</strong>
                            <ul style={styles.reasoningList}>
                              {risk.reasoning.map((reason, i) => (
                                <li key={i}>{reason}</li>
                              ))}
                            </ul>
                          </div>
                        )}
                      </div>
                    )}
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    </div>
  );
}

